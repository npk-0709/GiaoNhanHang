@model List<VanDon>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Trung tâm Người bán";
}
<div class="page-head">
    <h1>Quản lý vận đơn của bạn</h1>
    <div>
        <a class="btn btn-outline-brand me-2" asp-action="XuatExcel"><i class="bi bi-file-earmark-excel"></i> Xuất Excel</a>
        <button class="btn btn-brand" data-bs-toggle="modal" data-bs-target="#modalTaoDon" id="btnMoTaoDon">
            <i class="bi bi-plus-lg"></i> Tạo đơn mới
        </button>
    </div>
</div>

@if (TempData["ok"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
        @TempData["ok"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["loi"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
        @TempData["loi"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="panel flush">
    <div class="p-3 border-bottom bg-light">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-auto">
                <input type="text" name="q" value="@ViewBag.q" class="form-control" placeholder="Mã VĐ, Tên, SĐT..." />
            </div>
            <div class="col-auto">
                <select name="trangThai" class="form-select">
                    <option value="">-- Tất cả trạng thái --</option>
                    @foreach (var tt in ViewBag.TrangThaiList)
                    {
                        if (ViewBag.trangThai == tt)
                        {
                            <option value="@tt" selected>@tt</option>
                        }
                        else
                        {
                            <option value="@tt">@tt</option>
                        }
                    }
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-ink"><i class="bi bi-search"></i> Tìm kiếm</button>
            </div>
            @if (!string.IsNullOrEmpty(ViewBag.q) || !string.IsNullOrEmpty(ViewBag.trangThai))
            {
                <div class="col-auto">
                    <a asp-action="Dashboard" class="btn btn-outline-mut">Bỏ lọc</a>
                </div>
            }
        </form>
    </div>
    <div class="table-wrap">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Mã VĐ</th>
                    <th>Ngày tạo</th>
                    <th>Người nhận</th>
                    <th>Dịch vụ</th>
                    <th>Cước phí / COD</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in Model)
                {
                    <tr>
                        <td><strong>@v.MaVanDon</strong></td>
                        <td>@v.NgayTao.ToString("dd/MM/yyyy")</td>
                        <td>
                            <div>@v.NguoiNhan?.TenKH</div>
                            <small class="text-mut">@v.NguoiNhan?.SoDienThoai</small>
                        </td>
                        <td>@v.LoaiDichVu</td>
                        <td>
                            <div>@GiaoNhanHang.Helpers.Fmt.Tien(v.TongTien)</div>
                            @if(v.ThuCOD > 0) { <small class="text-mut">COD: @GiaoNhanHang.Helpers.Fmt.Tien(v.ThuCOD)</small> }
                        </td>
                        <td>
                            <span class="badge @GiaoNhanHang.Helpers.TT.Css(v.TrangThai)">@v.TrangThai</span>
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-ink" asp-action="ChiTiet" asp-route-id="@v.MaVanDon" title="Tra cứu">Tra cứu</a>
                            <a class="btn btn-sm btn-outline-ink" asp-action="InDon" asp-route-id="@v.MaVanDon" target="_blank" title="In đơn"><i class="bi bi-printer"></i></a>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-mut py-5">
                            Bạn chưa có vận đơn nào.
                            <a href="#" data-bs-toggle="modal" data-bs-target="#modalTaoDon">Tạo đơn ngay!</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal tạo đơn hàng -->
<div class="modal fade" id="modalTaoDon" tabindex="-1" aria-labelledby="modalTaoDonLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTaoDonLabel"><i class="bi bi-box-seam"></i> Tạo đơn hàng mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="modalTaoDonBody">
                <div class="text-center py-4">
                    <div class="spinner-border text-brand" role="status"></div>
                    <div class="mt-2 text-muted">Đang tải form...</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-brand" id="btnSubmitTaoDon">
                    <i class="bi bi-check-lg"></i> Tạo đơn hàng
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    var modal = document.getElementById('modalTaoDon');
    var body = document.getElementById('modalTaoDonBody');
    var btnSubmit = document.getElementById('btnSubmitTaoDon');
    var loaded = false;

    modal.addEventListener('show.bs.modal', function () {
        if (loaded) return;
        fetch('/KhachHang/GetTaoDonForm')
            .then(function (r) { return r.text(); })
            .then(function (html) {
                body.innerHTML = html;
                // Chạy script trong partial nếu có
                body.querySelectorAll('script').forEach(function (s) {
                    var ns = document.createElement('script');
                    ns.textContent = s.textContent;
                    document.body.appendChild(ns);
                    document.body.removeChild(ns);
                });
                loaded = true;
            })
            .catch(function () {
                body.innerHTML = '<div class="alert alert-danger">Không tải được form. Vui lòng thử lại.</div>';
            });
    });

    btnSubmit.addEventListener('click', function () {
        var form = document.getElementById('frmTaoDon');
        if (!form) return;
        btnSubmit.disabled = true;
        btnSubmit.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Đang tạo...';

        var fd = new FormData(form);
        fetch('/KhachHang/TaoDon', {
            method: 'POST',
            body: fd
        })
        .then(function (r) {
            var ct = r.headers.get('content-type') || '';
            if (ct.includes('application/json')) return r.json().then(function (d) { return { type: 'json', data: d }; });
            return r.text().then(function (t) { return { type: 'html', data: t }; });
        })
        .then(function (res) {
            if (res.type === 'json' && res.data.success) {
                // Thành công
                var bsModal = bootstrap.Modal.getInstance(modal);
                bsModal.hide();
                // Hiển thị thông báo và reload
                var alert = document.createElement('div');
                alert.className = 'alert alert-success alert-dismissible fade show mb-3';
                alert.innerHTML = res.data.message + '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>';
                document.querySelector('.page-head').after(alert);
                setTimeout(function () { location.reload(); }, 1500);
            } else if (res.type === 'html') {
                // Lỗi validation - hiện lại form với lỗi
                body.innerHTML = res.data;
                body.querySelectorAll('script').forEach(function (s) {
                    var ns = document.createElement('script');
                    ns.textContent = s.textContent;
                    document.body.appendChild(ns);
                    document.body.removeChild(ns);
                });
                loaded = false;
            }
        })
        .catch(function () {
            body.innerHTML = '<div class="alert alert-danger">Lỗi kết nối. Vui lòng thử lại.</div>';
        })
        .finally(function () {
            btnSubmit.disabled = false;
            btnSubmit.innerHTML = '<i class="bi bi-check-lg"></i> Tạo đơn hàng';
        });
    });

    // Reset form khi đóng modal
    modal.addEventListener('hidden.bs.modal', function () {
        loaded = false;
        body.innerHTML = '<div class="text-center py-4"><div class="spinner-border text-brand" role="status"></div><div class="mt-2 text-muted">Đang tải form...</div></div>';
    });
})();
</script>
}
