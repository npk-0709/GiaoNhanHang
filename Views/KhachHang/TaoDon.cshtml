@model VanDonCreateVM
@{
    ViewData["Title"] = "Tạo đơn hàng online";
}
<div class="page-head">
    <h1>Tạo đơn hàng online</h1>
    <a asp-action="Dashboard">Quay lại quản lý vận đơn</a>
</div>

<form method="post" asp-action="TaoDon" id="frm">
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger" role="alert">
            <ul class="mb-0 ps-3">
                @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@e.ErrorMessage</li>
                }
            </ul>
        </div>
    }
    <div class="row g-3">
        <div class="col-lg-8">
            <div class="panel mb-3">
                <h2>Người nhận hàng</h2>
                <div class="row g-3">
                    <div class="col-12">
                        <div class="p-3 mb-2 rounded" style="background:#F3F6FF; border:1px solid #E2E8F0">
                            <h3 class="h6 mb-3 text-brand"><i class="bi bi-person-circle"></i> Người gửi</h3>
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <input class="form-control" name="TenNguoiGui" value="@Model.TenNguoiGui" placeholder="Tên người gửi" required />
                                </div>
                                <div class="col-md-6">
                                    <input class="form-control" name="SdtGui" value="@Model.SdtGui" placeholder="Số điện thoại" required />
                                </div>
                                <div class="col-12">
                                    <input class="form-control" name="DiaChiGui" value="@Model.DiaChiGui" placeholder="Địa chỉ lấy hàng" required />
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-md-6">
                        <label class="form-label text-danger">Tên người nhận (*)</label>
                        <input class="form-control" name="TenNhan" value="@Model.TenNhan" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-danger">Số điện thoại (*)</label>
                        <input class="form-control" name="SdtNhan" value="@Model.SdtNhan" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-danger">Địa chỉ nhận (*)</label>
                        <input class="form-control" name="DiaChiNhan" value="@Model.DiaChiNhan" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Email người nhận</label>
                        <input class="form-control" name="EmailNhan" value="@Model.EmailNhan" type="email" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Kích thước (DxRxC cm)</label>
                        <input class="form-control" name="KichThuoc" value="@Model.KichThuoc" placeholder="VD: 10x10x10" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Giá trị bưu gửi (₫)</label>
                        <input class="form-control" type="number" name="GiaTriBuuGui" value="@Model.GiaTriBuuGui" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Thu hộ (COD ₫)</label>
                        <input class="form-control" type="number" name="ThuCOD" value="@Model.ThuCOD" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Thanh toán cước phí</label>
                        <select class="form-select" name="NguoiTraCuoc">
                            <option value="NguoiGui">Người gửi thanh toán</option>
                            <option value="NguoiNhan">Người nhận thanh toán</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Loại dịch vụ</label>
                        <select class="form-select" name="LoaiDichVu">
                            <option value="TieuChuan">Tiêu chuẩn</option>
                            <option value="TietKiem">Tiết kiệm</option>
                            <option value="HoaToc">Hỏa tốc</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Hướng dẫn giao hàng</label>
                        <input class="form-control" name="HuongDanGiaoHang" value="@Model.HuongDanGiaoHang" placeholder="VD: Gọi trước khi giao" />
                    </div>
                </div>
            </div>

            <div class="panel">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h2 class="mb-0">Hàng hóa</h2>
                    <button type="button" class="btn btn-sm btn-outline-ink" id="addRow"><i class="bi bi-plus-lg"></i> Thêm mặt hàng</button>
                </div>
                <div class="table-wrap">
                    <table class="table">
                        <thead><tr><th>Loại hàng</th><th>Số lượng</th><th>Trọng lượng (kg)</th><th>Ghi chú</th><th></th></tr></thead>
                        <tbody id="rows">
                            @foreach (var it in Model.Items)
                            {
                                <partial name="~/Views/VanDon/_ItemRow.cshtml" model="it" />
                            }
                        </tbody>
                    </table>
                </div>
                <div class="small text-mut">Trọng lượng là tổng khối lượng của dòng hàng đó.</div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="fee mb-3" aria-live="polite">
                <div class="text-mut small">Cước phí dự kiến</div>
                <div class="big" id="fee">0 ₫</div>
                <div class="small text-mut" id="feeNote">Nhập trọng lượng để tính cước.</div>
            </div>
            <button class="btn btn-brand w-100 btn-lg" type="submit">Tạo đơn hàng</button>
        </div>
    </div>
</form>

<template id="rowTpl"><partial name="~/Views/VanDon/_ItemRow.cshtml" model="new ItemVM()" /></template>

@section Scripts {
<script>
(function () {
  var rows = document.getElementById('rows');
  var tpl = document.getElementById('rowTpl');
  var timer;

  function reindex() {
    rows.querySelectorAll('tr.item-row').forEach(function (tr, i) {
      tr.querySelectorAll('[data-n]').forEach(function (el) { el.name = 'Items[' + i + '].' + el.dataset.n; });
    });
  }
  function estimate() {
    clearTimeout(timer);
    timer = setTimeout(async function () {
      var kg = 0, ids = [];
      rows.querySelectorAll('tr.item-row').forEach(function (tr) {
        var w = parseFloat(tr.querySelector('.kg').value);
        if (w > 0) kg += w;
        ids.push(tr.querySelector('select').value);
      });
      var fee = document.getElementById('fee'), note = document.getElementById('feeNote');
      if (kg <= 0) { fee.textContent = '0 ₫'; note.textContent = 'Nhập trọng lượng để tính cước.'; return; }
      try {
        var r = await fetch('/VanDon/TinhCuoc?kg=' + kg + '&loai=' + ids.join(','));
        var d = await r.json();
        fee.textContent = new Intl.NumberFormat('vi-VN').format(d.tien) + ' ₫';
        note.textContent = 'Tổng ' + kg.toFixed(2).replace(/\.?0+$/, '') + ' kg' + (d.bac ? ' · bậc giá ' + d.bac : '');
      } catch (e) { note.textContent = 'Không tính được cước, thử lại sau.'; }
    }, 250);
  }
  document.getElementById('addRow').addEventListener('click', function () {
    rows.appendChild(tpl.content.cloneNode(true));
    reindex(); estimate();
  });
  rows.addEventListener('click', function (e) {
    var b = e.target.closest('.btn-del');
    if (!b) return;
    if (rows.querySelectorAll('tr.item-row').length > 1) { b.closest('tr').remove(); reindex(); estimate(); }
  });
  rows.addEventListener('input', estimate);
  rows.addEventListener('change', estimate);
  reindex(); estimate();
})();
</script>
}
