@{
    string Act(string c) => string.Equals((string?)ViewContext.RouteData.Values["controller"], c, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    string ActA(string a) => string.Equals((string?)ViewContext.RouteData.Values["action"], a, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    bool quanLy = User.IsInRole("QuanLy");
    bool tiepNhan = User.IsInRole("TiepNhan");
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <partial name="_Head" />
    <title>@ViewData["Title"] - Giao Nhận</title>
</head>
<body class="app">
<aside class="side">
    <a class="brand" asp-controller="@(User.IsInRole("KhachHang") ? "KhachHang" : "Dashboard")" asp-action="@(User.IsInRole("KhachHang") ? "Dashboard" : "Index")"><span class="brand-mark"><i class="bi bi-box-seam"></i></span>Giao Nhận</a>

    @if (User.IsInRole("KhachHang"))
    {
        <a class="nav-i @ActA("Dashboard")" asp-controller="KhachHang" asp-action="Dashboard"><i class="bi bi-receipt"></i>Quản lý vận đơn</a>
        <a class="nav-i @ActA("TaoDon")" asp-controller="KhachHang" asp-action="TaoDon"><i class="bi bi-plus-circle"></i>Tạo đơn hàng online</a>
        <a class="nav-i @ActA("TaoNhieuDon")" asp-controller="KhachHang" asp-action="TaoNhieuDon"><i class="bi bi-file-earmark-excel"></i>Tạo nhiều đơn hàng</a>
        <a class="nav-i @ActA("NgoaiLe") text-danger" asp-controller="KhachHang" asp-action="NgoaiLe"><i class="bi bi-exclamation-triangle"></i>Giải quyết đơn lỗi</a>
        <a class="nav-i @ActA("ThongKe")" asp-controller="KhachHang" asp-action="ThongKe"><i class="bi bi-bar-chart"></i>Thống kê đơn hàng</a>
        <a class="nav-i @ActA("TaiKhoan")" asp-controller="KhachHang" asp-action="TaiKhoan"><i class="bi bi-wallet2"></i>Quản lý tài khoản</a>
        <a class="nav-i @ActA("HoSo")" asp-controller="KhachHang" asp-action="HoSo"><i class="bi bi-person"></i>Hồ sơ của shop</a>
    }
    else
    {
        <a class="nav-i @Act("Dashboard")" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2"></i>Tổng quan</a>
        <div class="grp">Nghiệp vụ</div>
        <a class="nav-i @Act("VanDon")" asp-controller="VanDon" asp-action="Index"><i class="bi bi-receipt"></i>Vận đơn</a>
        @if (quanLy || tiepNhan)
        {
            <a class="nav-i" asp-controller="VanDon" asp-action="Create"><i class="bi bi-plus-circle"></i>Lập vận đơn</a>
        }
        <a class="nav-i" asp-controller="VanDon" asp-action="CapNhatNhanh"><i class="bi bi-upc-scan"></i>Cập nhật nhanh</a>

        @if (quanLy || tiepNhan)
        {
            <div class="grp">Danh mục</div>
            <a class="nav-i @Act("KhachHang")" asp-controller="KhachHang" asp-action="Index"><i class="bi bi-people"></i>Khách hàng</a>
        }
        @if (quanLy)
        {
            <a class="nav-i @Act("NhanVien")" asp-controller="NhanVien" asp-action="Index"><i class="bi bi-person-badge"></i>Nhân viên</a>
            <a class="nav-i @Act("BuuCuc")" asp-controller="BuuCuc" asp-action="Index"><i class="bi bi-building"></i>Bưu cục, kho</a>
            <a class="nav-i @Act("BangGia")" asp-controller="BangGia" asp-action="Index"><i class="bi bi-cash-coin"></i>Bảng giá cước</a>
            <a class="nav-i @Act("LoaiHang")" asp-controller="LoaiHang" asp-action="Index"><i class="bi bi-tags"></i>Loại hàng hóa</a>
            <div class="grp">Báo cáo</div>
            <a class="nav-i @Act("BaoCao")" asp-controller="BaoCao" asp-action="Index"><i class="bi bi-bar-chart-line"></i>Doanh thu, hiệu suất</a>
        }
    }

    <div class="me">
        <div class="fw-semibold text-white">@User.Identity?.Name</div>
        <div class="mb-1" style="color:#7E8BA8">@(User.IsInRole("KhachHang") ? "Khách hàng" : User.IsInRole("QuanLy") ? "Quản lý" : User.IsInRole("TiepNhan") ? "Nhân viên tiếp nhận" : "Nhân viên giao hàng")</div>
        <form asp-controller="Account" asp-action="Logout" method="post"><button type="submit"><i class="bi bi-box-arrow-right"></i> Đăng xuất</button></form>
    </div>
</aside>

<main class="main">
    @if (TempData["ok"] is string ok)
    {
        <div class="alert alert-success py-2" role="status">@ok</div>
    }
    @if (TempData["loi"] is string loi)
    {
        <div class="alert alert-danger py-2" role="alert">@loi</div>
    }
    @RenderBody()
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
