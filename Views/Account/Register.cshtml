@{
    Layout = null;
    ViewData["Title"] = "Đăng ký Khách Hàng";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <partial name="_Head" />
    <title>Đăng ký - Giao Nhận</title>
</head>
<body>
<div class="login-wrap">
    <div class="login-side">
        <a class="brand text-white" asp-controller="Home" asp-action="Index"><span class="brand-mark"><i class="bi bi-box-seam"></i></span>Giao Nhận</a>
        <h1>Mỗi vận đơn đều có một hành trình rõ ràng</h1>
        <div style="color:#9FB0D4">Quản lý vận đơn và điều phối giao nhận hàng hóa</div>
    </div>
    <div class="login-form">
        <form method="post" asp-action="Register">
            <h2 class="h4 mb-3">Đăng ký tài khoản khách hàng</h2>
            @if (ViewData["loi"] is string loi)
            {
                <div class="alert alert-danger py-2" role="alert">@loi</div>
            }
            <div class="mb-3">
                <label class="form-label">Tên khách hàng (*)</label>
                <input class="form-control" name="tenKH" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Số điện thoại (*)</label>
                <input class="form-control" name="soDienThoai" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Mật khẩu (*)</label>
                <input class="form-control" name="matKhau" type="password" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Email</label>
                <input class="form-control" name="email" type="email" />
            </div>
            <div class="mb-3">
                <label class="form-label">Địa chỉ</label>
                <input class="form-control" name="diaChi" />
            </div>
            <button class="btn btn-brand w-100" type="submit">Đăng ký</button>
            <div class="mt-3 text-center">
                Đã có tài khoản? <a asp-action="UserLogin">Đăng nhập</a>
            </div>
        </form>
    </div>
</div>
</body>
</html>
