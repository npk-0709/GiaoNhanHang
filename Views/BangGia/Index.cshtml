@model List<BangGia>
@{ ViewData["Title"] = "Bảng giá cước"; }
<div class="page-head">
    <h1>Bảng giá cước</h1>
    <button class="btn btn-brand" data-bs-toggle="modal" data-bs-target="#m" data-modal="#m" data-title="Thêm bậc giá"><i class="bi bi-plus-lg"></i> Thêm bậc giá</button>
</div>
<p class="text-mut">Cước của vận đơn = đơn giá của bậc chứa tổng khối lượng (lớn hơn “từ”, nhỏ hơn hoặc bằng “đến”) × hệ số phụ phí lớn nhất trong các loại hàng của đơn.</p>
<div class="panel flush">
    <div class="table-wrap">
        <table class="table table-hover">
            <thead><tr><th>Mã</th><th>Khối lượng từ (kg)</th><th>Đến (kg)</th><th>Đơn giá</th><th style="width:110px"></th></tr></thead>
            <tbody>
            @foreach (var b in Model)
            {
                <tr>
                    <td>@b.MaBangGia</td><td>@Fmt.So(b.KhoiLuongTu)</td><td>@Fmt.So(b.KhoiLuongDen)</td><td class="fw-semibold">@Fmt.Tien(b.DonGia)</td>
                    <td class="text-end text-nowrap">
                        <button class="btn btn-sm btn-outline-secondary" aria-label="Sửa" data-bs-toggle="modal" data-bs-target="#m" data-modal="#m" data-title="Sửa bậc giá"
                                data-json="@System.Text.Json.JsonSerializer.Serialize(new { b.MaBangGia, b.KhoiLuongTu, b.KhoiLuongDen, b.DonGia })"><i class="bi bi-pencil"></i></button>
                        <form class="d-inline" method="post" asp-action="Xoa" asp-route-id="@b.MaBangGia" data-confirm="Xóa bậc giá này?">
                            <button class="btn btn-sm btn-outline-danger" aria-label="Xóa"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
<div class="modal fade" id="m" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog"><form class="modal-content" method="post" asp-action="Luu">
    <div class="modal-header"><h2 class="modal-title h5">Bậc giá</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div>
    <div class="modal-body">
      <input type="hidden" name="MaBangGia" value="0" />
      <div class="row g-3">
        <div class="col-6"><label class="form-label">Khối lượng từ (kg)</label><input class="form-control" type="number" step="0.01" min="0" name="KhoiLuongTu" required /></div>
        <div class="col-6"><label class="form-label">Khối lượng đến (kg)</label><input class="form-control" type="number" step="0.01" min="0.01" name="KhoiLuongDen" required /></div>
        <div class="col-12"><label class="form-label">Đơn giá (₫)</label><input class="form-control" type="number" step="1000" min="0" name="DonGia" required /></div>
      </div>
    </div>
    <div class="modal-footer"><button type="button" class="btn btn-outline-ink" data-bs-dismiss="modal">Hủy</button><button class="btn btn-brand" type="submit">Lưu bậc giá</button></div>
  </form></div>
</div>
